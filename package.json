{
  "name": "bernstein-mcp",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Cloudflare Worker: stateless MCP endpoint at mcp.bernstein.run.",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "bash scripts/check-no-fetch.sh && bash scripts/check-data-tag.sh && vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json",
    "build:cli": "node scripts/build-cli.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "2.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "^5.4.0",
    "vitest": "4.1.11",
    "wrangler": "4.134.0"
  }
}
